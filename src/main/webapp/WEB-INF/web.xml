<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
   version="4.0">
    <filter>
        <filter-name>encoding</filter-name>
        <filter-class>com.qlktx.filter.RequestEncodingFilter</filter-class>
    </filter>
    <filter-mapping><filter-name>encoding</filter-name><url-pattern>/*</url-pattern></filter-mapping>
    <filter>
        <filter-name>authentication</filter-name>
        <filter-class>com.qlktx.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping><filter-name>authentication</filter-name><url-pattern>/*</url-pattern></filter-mapping>
    <filter>
        <filter-name>csrf</filter-name>
        <filter-class>com.qlktx.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping><filter-name>csrf</filter-name><url-pattern>/*</url-pattern></filter-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
        <cookie-config><http-only>true</http-only></cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
    <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
    <error-page><error-code>403</error-code><location>/WEB-INF/views/common/errors/error.jsp</location></error-page>
    <error-page><error-code>404</error-code><location>/WEB-INF/views/common/errors/error.jsp</location></error-page>
    <error-page><error-code>500</error-code><location>/WEB-INF/views/common/errors/error.jsp</location></error-page>
    <error-page><error-code>503</error-code><location>/WEB-INF/views/common/errors/error.jsp</location></error-page>
</web-app>
