<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<fmt:setLocale value="vi_VN"/>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><c:out value="${pageTitle}"/> | KTX</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"><link rel="stylesheet" href="<c:url value='/assets/css/style.css'/>"><link rel="stylesheet" href="<c:url value='/assets/css/auth.css'/>"><link rel="stylesheet" href="<c:url value='/assets/css/application.css'/>"><link rel="stylesheet" href="<c:url value='/assets/css/profile-dropdown.css'/>"><c:choose><c:when test="${sessionScope.authUser.admin}"><link rel="stylesheet" href="<c:url value='/assets/css/admin.css'/>"></c:when><c:otherwise><link rel="stylesheet" href="<c:url value='/assets/css/student.css'/>"></c:otherwise></c:choose></head><body class="${sessionScope.authUser.admin ? 'admin-app' : 'student-app'} ${printMode ? 'print-view' : ''}">
<a class="skip-link" href="#main-content">Đến nội dung chính</a>
<aside class="sidebar" id="app-navigation"><a class="brand" href="<c:url value='${sessionScope.authUser.homePath}'/>"><span class="brand-mark">⌂</span><span><strong>KTX.</strong><small>Quản lý nội trú</small></span></a><div class="role-label">${sessionScope.authUser.admin ? 'Khu vực quản trị' : 'Không gian sinh viên'}</div><nav class="nav-list" aria-label="Menu chính">
<c:forEach items="${features}" var="item"><c:if test="${sessionScope.authUser.admin or (item.key != 'register' and item.key != 'profile')}"><a class="nav-link ${selectedMenu == item.key ? 'active' : ''}" href="<c:url value='${routePrefix}'/>/<c:out value='${item.key}'/>" ${selectedMenu == item.key ? 'aria-current="page"' : ''}><c:if test="${not sessionScope.authUser.admin}"><svg class="nav-icon" aria-hidden="true"><use href="<c:url value='/assets/icons/student.svg'/>#${item.key}"/></svg></c:if><c:out value="${item.title}"/></a></c:if></c:forEach></nav><div class="sidebar-bottom"><c:if test="${not sessionScope.authUser.admin}"><a class="nav-link ${selectedMenu == 'profile' or selectedMenu == 'password' ? 'active' : ''}" href="<c:url value='/student/profile'/>"><svg class="nav-icon" aria-hidden="true"><use href="<c:url value='/assets/icons/student.svg'/>#profile"/></svg>Hồ sơ &amp; tài khoản</a></c:if><form class="logout-form" method="post" action="<c:url value='/auth/logout'/>"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><button class="logout-button" type="submit">↪ Đăng xuất</button></form></div></aside>
<div class="app-shell"><header class="topbar"><button class="mobile-nav-toggle" type="button" aria-controls="app-navigation" aria-expanded="false" data-nav-toggle>☰ <span>Menu</span></button><div class="breadcrumb"><span>${sessionScope.authUser.admin ? 'Quản trị viên' : 'Sinh viên'}</span><span>/</span><strong><c:out value="${pageTitle}"/></strong></div><div class="topbar-tools"><%@ include file="../components/profile-dropdown.jspf" %></div></header><main class="content" id="main-content" tabindex="-1"><%@ include file="../components/messages.jspf" %>

