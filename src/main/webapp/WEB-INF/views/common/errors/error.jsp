<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" isErrorPage="true" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Thông báo | KTX</title><link rel="stylesheet" href="<c:url value='/assets/css/style.css'/>"><link rel="stylesheet" href="<c:url value='/assets/css/auth.css'/>"></head><body><main class="error-page"><strong><c:out value="${requestScope['javax.servlet.error.status_code']}"/></strong><h1><c:choose><c:when test="${requestScope['javax.servlet.error.status_code'] == 403}">Không thể truy cập trang này</c:when><c:when test="${requestScope['javax.servlet.error.status_code'] == 404}">Không tìm thấy trang</c:when><c:otherwise>Hệ thống tạm thời chưa sẵn sàng</c:otherwise></c:choose></h1><p><c:choose><c:when test="${not empty errorMessage}"><c:out value="${errorMessage}"/></c:when><c:when test="${requestScope['javax.servlet.error.status_code'] == 403}">Tài khoản hiện tại không có quyền truy cập hoặc phiên thao tác đã hết hạn.</c:when><c:otherwise>Vui lòng kiểm tra lại đường dẫn hoặc thử lại sau.</c:otherwise></c:choose></p><a class="btn btn-primary" href="<c:url value='/auth/login'/>">Về trang đăng nhập</a></main></body></html>
