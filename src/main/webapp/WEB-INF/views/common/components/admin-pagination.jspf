<%@ page pageEncoding="UTF-8" %>
<div class="portal-list-meta"><span><c:out value="${empty totalRecords ? 0 : totalRecords}"/> bản ghi</span><c:if test="${totalPages > 1}"><span>Trang ${currentPage} / ${totalPages}</span></c:if></div>
<c:if test="${totalPages > 1}"><nav class="portal-pagination" aria-label="Phân trang"><c:forEach begin="1" end="${totalPages}" var="pageNumber"><c:url value="/admin/${selectedMenu}" var="paginationUrl"><c:param name="page" value="${pageNumber}"/><c:param name="q" value="${q}"/><c:param name="zone" value="${zone}"/><c:param name="floor" value="${floor}"/><c:param name="status" value="${status}"/></c:url><a class="${pageNumber == currentPage ? 'active' : ''}" href="<c:out value='${paginationUrl}'/>" ${pageNumber == currentPage ? 'aria-current="page"' : ''}>${pageNumber}</a></c:forEach></nav></c:if>
