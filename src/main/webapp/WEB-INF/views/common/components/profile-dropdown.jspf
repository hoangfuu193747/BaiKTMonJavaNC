<%@ page pageEncoding="UTF-8" %>
<div class="profile-dropdown" data-profile-dropdown>
<button class="user-menu profile-toggle" type="button" aria-label="Mở menu tài khoản" aria-haspopup="menu" aria-expanded="false" aria-controls="account-dropdown-menu" data-profile-toggle>
<span class="avatar" aria-hidden="true">${sessionScope.authUser.admin ? 'QT' : 'SV'}</span>
<span class="profile-trigger-copy"><strong><c:out value="${sessionScope.authUser.displayName}"/></strong><small><c:out value="${sessionScope.authUser.username}"/></small></span>
<svg class="profile-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
</button>
<div class="profile-panel" id="account-dropdown-menu" role="menu" aria-label="Menu tài khoản" hidden>
<div class="profile-menu-header" role="none"><span class="avatar" aria-hidden="true">${sessionScope.authUser.admin ? 'QT' : 'SV'}</span><div><strong><c:out value="${sessionScope.authUser.displayName}"/></strong><small>${sessionScope.authUser.admin ? 'Quản trị viên' : 'Sinh viên'} · <c:out value="${sessionScope.authUser.username}"/></small><c:if test="${not empty sessionScope.authUser.email}"><small class="profile-email"><c:out value="${sessionScope.authUser.email}"/></small></c:if></div></div>
<a class="profile-item" role="menuitem" href="<c:url value='${routePrefix}'/>/profile">
<svg class="profile-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg><span>Hồ sơ cá nhân</span></a>
<a class="profile-item" role="menuitem" href="<c:url value='${routePrefix}'/>/notifications">
<svg class="profile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg><span>Thông báo</span></a>
<a class="profile-item" role="menuitem" href="<c:url value='${routePrefix}/password'/>"><svg class="profile-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4m-4 5v2"/></svg><span>Đổi mật khẩu</span></a>
<div class="profile-divider" role="separator"></div>
<form class="profile-logout-form" role="none" method="post" action="<c:url value='/auth/logout'/>"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><button class="profile-item profile-logout" type="submit" role="menuitem">
<svg class="profile-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H4v16h5m5-13 5 5-5 5M8 12h11"/></svg><span>Đăng xuất</span></button></form>
</div></div>

