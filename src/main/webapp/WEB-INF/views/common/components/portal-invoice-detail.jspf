<%@ page pageEncoding="UTF-8" %>
<c:if test="${not empty invoice}"><section class="panel"><div class="panel-head"><h2>Hóa đơn HD${invoice.maHoaDon}</h2><span class="tag ${invoice.trangThai == 'DA_THANH_TOAN' ? '' : 'amber'}"><c:out value="${statusLabels[invoice.trangThai]}"/></span></div><div class="panel-body">
<div class="portal-invoice-layout"><dl class="detail-list"><div><dt>Phòng · Kỳ</dt><dd><c:out value="${invoice.maPhong}"/> · ${invoice.thang}/${invoice.nam}</dd></div><div><dt>Tiền phòng</dt><dd><c:out value="${invoice.tienPhongText}"/></dd></div><div><dt>Tiền điện</dt><dd><c:out value="${invoice.tienDienText}"/></dd></div><div><dt>Tiền nước</dt><dd><c:out value="${invoice.tienNuocText}"/></dd></div><div><dt>Tổng tiền</dt><dd><c:out value="${invoice.tongTienText}"/></dd></div></dl>
<dl class="detail-list portal-invoice-balance"><div><dt>Đã đóng</dt><dd><c:out value="${invoice.daDongText}"/></dd></div><div><dt>Chờ duyệt</dt><dd><c:out value="${invoice.choXacNhanText}"/></dd></div><div><dt>Còn phải đóng</dt><dd><c:out value="${invoice.conNoText}"/></dd></div><div><dt>Hạn đóng</dt><dd><c:out value="${invoice.hanThanhToanText}"/></dd></div></dl></div>
<c:if test="${not adminView and invoice.coTheGui > 0}"><a class="btn btn-primary section-gap" href="<c:url value='/student/payments'/>?invoice=${invoice.maHoaDon}">Thanh toán mẫu</a></c:if>
<c:if test="${not adminView and invoice.conNo > 0 and invoice.coTheGui <= 0}"><p class="info-box section-gap">Đã gửi đủ số tiền còn lại và đang chờ xác nhận. Bạn không cần gửi thêm.</p></c:if>
</div></section></c:if>
