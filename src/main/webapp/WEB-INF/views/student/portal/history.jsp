<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<%@ include file="../../common/components/student-heading.jspf" %>
<c:choose><c:when test="${not empty registration}">
<a class="btn btn-outline non-print" href="<c:url value='/student/history'/>">← Tất cả đơn đăng ký</a>
<section class="panel section-gap"><div class="panel-head"><h2>Đơn DK${registration.maDK}</h2><span class="tag ${registration.trangThai == 'CHO_DUYET' ? 'amber' : (registration.trangThai == 'TU_CHOI' ? 'red' : '')}"><c:out value="${statusLabels[registration.trangThai]}"/></span></div><div class="panel-body"><dl class="detail-list"><div><dt>Phòng đăng ký</dt><dd><c:out value="${registration.maPhong}"/></dd></div><div><dt>Ngày gửi</dt><dd><c:out value="${registration.ngayDangKyText}"/></dd></div><c:if test="${not empty registration.ngayDuyet}"><div><dt>Ngày xử lý</dt><dd><c:out value="${registration.ngayDuyetText}"/></dd></div></c:if><c:if test="${not empty registration.lyDoTuChoi}"><div><dt>Lý do từ chối</dt><dd><c:out value="${registration.lyDoTuChoi}"/></dd></div></c:if></dl>
<c:choose><c:when test="${registration.trangThai == 'CHO_DUYET'}"><p class="portal-help">Đơn đang chờ ban quản lý xét duyệt. Bạn có thể hủy trước khi đơn được xử lý.</p><form method="post" action="<c:url value='/student/history'/>" data-confirm="Hủy đơn đăng ký đang chờ duyệt này?"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value="${registration.maDK}"><button class="btn btn-danger">Hủy đơn đăng ký</button></form></c:when><c:when test="${registration.trangThai == 'DA_DUYET'}"><a class="btn btn-primary section-gap" href="<c:url value='/student/contracts'/>">Xem hợp đồng</a></c:when><c:otherwise><a class="btn btn-outline section-gap" href="<c:url value='/student/rooms'/>">Tìm phòng phù hợp</a></c:otherwise></c:choose>
</div></section>
</c:when><c:otherwise>
<section class="panel"><form class="filter-bar" method="get" action="<c:url value='/student/history'/>"><div class="field"><label class="visually-hidden" for="registration-status">Trạng thái đơn</label><select id="registration-status" class="form-select" name="status"><option value="">Tất cả trạng thái</option><c:forTokens items="CHO_DUYET,DA_DUYET,TU_CHOI,DA_HUY" delims="," var="state"><option value="${state}" ${status == state ? 'selected' : ''}><c:out value="${statusLabels[state]}"/></option></c:forTokens></select></div><button class="btn btn-outline">Lọc đơn</button><c:if test="${not empty status}"><a class="text-link" href="<c:url value='/student/history'/>">Xóa bộ lọc</a></c:if></form>
<div class="table-wrap portal-table"><table><thead><tr><th>Mã đơn</th><th>Phòng</th><th>Ngày gửi</th><th>Kết quả</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${registrations}" var="application"><tr><td><strong>DK${application.maDK}</strong></td><td><c:out value="${application.maPhong}"/></td><td><c:out value="${application.ngayDangKyText}"/></td><td><span class="tag ${application.trangThai == 'CHO_DUYET' ? 'amber' : (application.trangThai == 'TU_CHOI' ? 'red' : '')}"><c:out value="${statusLabels[application.trangThai]}"/></span><c:if test="${not empty application.lyDoTuChoi}"><small class="portal-cell-note"><c:out value="${application.lyDoTuChoi}"/></small></c:if></td><td><a class="btn btn-outline btn-sm" href="<c:url value='/student/history'/>?id=${application.maDK}">Xem chi tiết</a></td></tr></c:forEach><c:if test="${empty registrations}"><tr><td colspan="5" class="empty-cell">Chưa có đơn phù hợp. <a href="<c:url value='/student/rooms'/>">Tìm phòng để đăng ký</a></td></tr></c:if></tbody></table></div></section>
</c:otherwise></c:choose>
<%@ include file="../../common/layouts/app-end.jspf" %>
