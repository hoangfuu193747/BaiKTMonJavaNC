<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<%@ include file="../../common/components/student-heading.jspf" %>
<div class="student-profile-layout">
  <section class="panel"><div class="profile-cover"><span class="avatar" aria-hidden="true">SV</span><div><h2><c:out value="${profile.hoTen}"/></h2><p><c:out value="${profile.maSV}"/> · <c:out value="${profile.lop}"/></p></div></div><div class="panel-body"><h3>Thông tin học tập</h3><dl class="portal-detail-grid section-gap"><div><dt>Mã sinh viên</dt><dd><c:out value="${profile.maSV}"/></dd></div><div><dt>Lớp</dt><dd><c:out value="${profile.lop}"/></dd></div><div><dt>Ngày sinh</dt><dd><c:out value="${profile.ngaySinhText}"/></dd></div><div><dt>Giới tính</dt><dd><c:out value="${profile.gioiTinh}"/></dd></div><div><dt>Khoa</dt><dd><c:out value="${profile.khoa}"/></dd></div><div><dt>Email trường</dt><dd><c:out value="${profile.email}"/></dd></div></dl><p class="portal-help">Thông tin học tập được đồng bộ từ hồ sơ trường. Nếu có sai sót, hãy liên hệ ban quản lý để được hỗ trợ.</p></div></section>
  <div><section class="panel"><div class="panel-head"><h2>Thông tin liên hệ</h2></div><div class="panel-body"><c:choose><c:when test="${editing}"><form class="portal-form" method="post" action="<c:url value='/student/profile'/>"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="update"><div class="field"><label for="phone">Số điện thoại <span class="muted">(tùy chọn)</span></label><input id="phone" class="form-control" name="phone" type="tel" maxlength="15" autocomplete="tel" pattern="\+?[0-9]{9,14}" aria-describedby="phone-help" placeholder="Ví dụ: 0912345678" value="<c:out value='${param.phone != null ? param.phone : profile.soDienThoai}'/>"><small id="phone-help">Từ 9–14 chữ số, có thể bắt đầu bằng +. Để trống nếu muốn xóa số cũ.</small></div><div class="button-group"><button class="btn btn-primary">Lưu thay đổi</button><a class="btn btn-outline" href="<c:url value='/student/profile'/>">Hủy</a></div></form></c:when><c:otherwise><p class="muted">Số điện thoại</p><p class="student-contact"><c:out value="${empty profile.soDienThoai ? 'Chưa cập nhật' : profile.soDienThoai}"/></p><a class="btn btn-outline" href="<c:url value='/student/profile'/>?action=edit">Cập nhật liên hệ</a></c:otherwise></c:choose></div></section>
  <section class="panel"><div class="panel-head"><h2>Bảo mật tài khoản</h2></div><div class="panel-body"><p class="muted">Sử dụng mật khẩu riêng và đổi mật khẩu nếu bạn nghi ngờ tài khoản bị truy cập.</p><a class="btn btn-outline section-gap" href="<c:url value='/student/password'/>">Đổi mật khẩu</a></div></section></div>
</div>
<%@ include file="../../common/layouts/app-end.jspf" %>
