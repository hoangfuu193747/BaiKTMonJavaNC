<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<%@ include file="../../common/components/student-heading.jspf" %>
<section class="panel student-form-panel"><div class="panel-head"><h2>Thiết lập mật khẩu mới</h2></div><div class="panel-body"><form class="portal-form" method="post" action="<c:url value='/student/password'/>"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="change">
<div class="field"><label for="currentPassword">Mật khẩu hiện tại</label><div class="student-password-field"><input id="currentPassword" name="currentPassword" type="password" class="form-control" autocomplete="current-password" maxlength="128" required><button type="button" hidden data-password-toggle="currentPassword" aria-controls="currentPassword" aria-pressed="false">Hiện</button></div></div>
<div class="field"><label for="newPassword">Mật khẩu mới</label><div class="student-password-field"><input id="newPassword" name="newPassword" type="password" class="form-control" autocomplete="new-password" minlength="8" maxlength="72" aria-describedby="password-help" required><button type="button" hidden data-password-toggle="newPassword" aria-controls="newPassword" aria-pressed="false">Hiện</button></div><small id="password-help">Tối thiểu 8 ký tự, tối đa 72 byte UTF-8. Chọn mật khẩu khác mật khẩu hiện tại.</small></div>
<div class="field"><label for="confirmPassword">Xác nhận mật khẩu mới</label><div class="student-password-field"><input id="confirmPassword" name="confirmPassword" type="password" class="form-control" autocomplete="new-password" minlength="8" maxlength="72" required><button type="button" hidden data-password-toggle="confirmPassword" aria-controls="confirmPassword" aria-pressed="false">Hiện</button></div></div>
<p class="info-box">Sau khi đổi mật khẩu thành công, bạn cần đăng nhập lại.</p><div class="button-group"><button class="btn btn-primary">Lưu mật khẩu mới</button><a class="btn btn-outline" href="<c:url value='/student/profile'/>">Quay lại hồ sơ</a></div></form></div></section>
<%@ include file="../../common/layouts/app-end.jspf" %>
