<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<%@ include file="../../common/components/student-heading.jspf" %>
<section class="panel"><form class="filter-bar" method="get" action="<c:url value='/student/notifications'/>" role="search"><div class="field"><label for="notice-search" class="visually-hidden">Tìm thông báo</label><input id="notice-search" class="control" name="q" maxlength="100" placeholder="Tìm theo tiêu đề hoặc nội dung…" value="<c:out value='${q}'/>"></div><button class="btn btn-primary">Tìm kiếm</button><c:if test="${not empty q}"><a class="btn btn-outline" href="<c:url value='/student/notifications'/>">Xóa bộ lọc</a></c:if></form></section>
<div class="student-notice-list"><c:forEach items="${notifications}" var="notice"><article class="portal-notice" id="notice-${notice.maTB}"><small>Ban quản lý KTX · <c:out value="${notice.ngayDangText}"/></small><h2><c:out value="${notice.tieuDe}"/></h2><p class="preserve-text"><c:out value="${notice.noiDung}"/></p></article></c:forEach><c:if test="${empty notifications}"><section class="panel"><div class="student-empty"><h2>${empty q ? 'Chưa có thông báo mới' : 'Không tìm thấy thông báo'}</h2><p>${empty q ? 'Thông tin từ ban quản lý sẽ được cập nhật tại đây.' : 'Thử từ khóa ngắn hơn hoặc xóa bộ lọc để xem tất cả thông báo.'}</p></div></section></c:if></div>
<%@ include file="../../common/layouts/app-end.jspf" %>
