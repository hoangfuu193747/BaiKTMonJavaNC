<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<%@ include file="../../common/components/student-heading.jspf" %>
<ol class="student-steps" aria-label="Quy trình đăng ký"><li>01 · Chọn phòng</li><li aria-current="step">02 · Kiểm tra &amp; gửi đơn</li><li>03 · Chờ xét duyệt</li></ol>
<c:choose><c:when test="${empty room}"><section class="panel"><div class="student-empty"><h2>Bạn muốn ở phòng nào?</h2><p>Tìm phòng theo khu, tầng và mức giá trước khi gửi đăng ký.</p><a class="btn btn-primary" href="<c:url value='/student/rooms'/>">Chọn phòng</a></div></section></c:when><c:otherwise>
<div class="student-review-layout"><section class="panel"><div class="panel-head"><h2>Kiểm tra thông tin đăng ký</h2><span class="tag ${empty reasons ? '' : 'amber'}">${empty reasons ? 'Đủ điều kiện' : 'Chưa đủ điều kiện'}</span></div><div class="panel-body"><h3>Người đăng ký</h3><dl class="detail-list section-gap"><div><dt>Họ và tên</dt><dd><c:out value="${profile.hoTen}"/></dd></div><div><dt>Mã sinh viên</dt><dd><c:out value="${profile.maSV}"/></dd></div><div><dt>Lớp</dt><dd><c:out value="${profile.lop}"/></dd></div><div><dt>Email</dt><dd><c:out value="${profile.email}"/></dd></div></dl><p class="portal-help">Thông tin được lấy từ hồ sơ sinh viên, bạn không cần nhập lại.</p><c:choose><c:when test="${empty reasons}"><form method="post" action="<c:url value='/student/register'/>" data-confirm="Gửi đơn đăng ký phòng này?"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="submit"><input type="hidden" name="room" value="<c:out value='${room.maPhong}'/>"><p class="info-box">Gửi đơn chưa đồng nghĩa với giữ chỗ. Chỗ ở được xác nhận sau khi ban quản lý duyệt và tạo hợp đồng.</p><div class="button-group"><button class="btn btn-primary">Xác nhận gửi đăng ký</button><a class="btn btn-outline" href="<c:url value='/student/rooms'/>">Chọn phòng khác</a></div></form></c:when><c:otherwise><div class="student-warning"><h3>Chưa thể gửi đăng ký</h3><ul class="portal-reasons"><c:forEach items="${reasons}" var="reason"><li><c:out value="${reason}"/></li></c:forEach></ul></div><div class="button-group section-gap"><c:choose><c:when test="${hasActiveContract}"><a class="btn btn-primary" href="<c:url value='/student/contracts'/>">Xem hợp đồng đang ở</a></c:when><c:when test="${hasPendingRegistration}"><a class="btn btn-primary" href="<c:url value='/student/history'/>">Theo dõi đơn chờ duyệt</a></c:when></c:choose><a class="btn btn-outline" href="<c:url value='/student/rooms'/>">Tìm phòng khác</a></div></c:otherwise></c:choose></div></section>
<aside class="panel student-room-summary"><div class="panel-body"><p class="eyebrow">PHÒNG ĐÃ CHỌN</p><h2 class="student-room-title"><c:out value="${room.maPhong}"/></h2><p class="muted"><c:out value="${room.tenKhu}"/> · Tầng ${room.tang}</p><strong class="student-room-cost"><c:out value="${room.giaMoiSVText}"/></strong><p class="muted">mỗi sinh viên / tháng</p><dl class="detail-list section-gap"><div><dt>Dành cho</dt><dd><c:out value="${room.gioiTinh}"/></dd></div><div><dt>Sức chứa</dt><dd>${room.sucChua} sinh viên</dd></div><div><dt>Chỗ còn trống</dt><dd>${room.conCho}</dd></div></dl></div></aside></div>
</c:otherwise></c:choose>
<%@ include file="../../common/layouts/app-end.jspf" %>
