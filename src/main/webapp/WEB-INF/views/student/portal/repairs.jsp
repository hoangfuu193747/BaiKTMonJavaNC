<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<%@ include file="../../common/components/student-heading.jspf" %>
<div class="student-repairs-layout">
<section class="panel"><div class="panel-head"><h2>Báo sự cố trong phòng</h2></div><div class="panel-body"><c:choose><c:when test="${empty activeContract}"><div class="student-empty"><h3>Bạn chưa có phòng đang ở</h3><p>Chức năng báo sửa chữa được mở khi bạn có hợp đồng nội trú đang hoạt động.</p><a class="btn btn-outline" href="<c:url value='/student/contracts'/>">Xem hợp đồng</a></div></c:when><c:otherwise><p class="portal-room-label">Phòng <strong><c:out value="${activeContract.maPhong}"/></strong><span class="tag">Đang ở</span></p><form class="portal-form" method="post" action="<c:url value='/student/repairs'/>"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="submit"><div class="field"><label for="description">Mô tả sự cố</label><textarea id="description" name="description" class="form-control" maxlength="1000" rows="5" placeholder="Ví dụ: Vòi nước tại bồn rửa bị rò rỉ từ sáng nay." aria-describedby="repair-help repair-count" data-character-count="repair-count" required><c:out value="${param.description}"/></textarea><span class="student-character-count" id="repair-count">Tối đa 1000 ký tự</span><small id="repair-help">Nêu rõ thiết bị, vị trí và tình trạng hỏng để ban quản lý hỗ trợ nhanh hơn.</small></div><button class="btn btn-primary">Gửi yêu cầu sửa chữa</button></form></c:otherwise></c:choose></div></section>
<section class="panel"><div class="panel-head"><h2>Yêu cầu của tôi</h2><span class="muted">Mới nhất trước</span></div><c:forEach items="${repairs}" var="repair"><article class="student-repair-card"><header><h3>YC${repair.maYC} · <c:out value="${repair.maPhong}"/></h3><span class="tag ${repair.trangThai == 'HOAN_THANH' ? '' : 'amber'}"><c:out value="${statusLabels[repair.trangThai]}"/></span></header><p class="preserve-text"><c:out value="${repair.noiDung}"/></p><small>Gửi ngày <c:out value="${repair.ngayGuiText}"/></small></article></c:forEach><c:if test="${empty repairs}"><div class="student-empty"><h3>Chưa có yêu cầu sửa chữa</h3><p>Các sự cố bạn đã gửi và tiến độ xử lý sẽ xuất hiện tại đây.</p></div></c:if></section>
</div>
<%@ include file="../../common/layouts/app-end.jspf" %>
