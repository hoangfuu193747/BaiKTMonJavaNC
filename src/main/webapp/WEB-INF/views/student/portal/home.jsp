<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<section class="student-welcome">
  <div><p class="eyebrow">KHÔNG GIAN SINH VIÊN</p><h1>Xin chào, <c:out value="${profile.hoTen}"/>!</h1><p>Theo dõi chỗ ở, chi phí và các yêu cầu của bạn tại một nơi.</p></div>
  <c:choose><c:when test="${canRegister}"><a class="btn btn-primary" href="<c:url value='/student/rooms'/>">Tìm phòng ngay →</a></c:when><c:when test="${not empty activeContract}"><a class="btn btn-primary" href="<c:url value='/student/contracts'/>?id=${activeContract.maHDong}">Xem chỗ ở của tôi →</a></c:when><c:otherwise><a class="btn btn-primary" href="<c:url value='/student/history'/>">Theo dõi đơn đăng ký →</a></c:otherwise></c:choose>
</section>
<div class="metrics metrics-four">
  <a class="metric" href="<c:url value='/student/contracts'/>"><div class="metric-top"><span>Phòng đang ở</span><svg class="nav-icon" aria-hidden="true"><use href="<c:url value='/assets/icons/student.svg'/>#rooms"/></svg></div><div class="metric-value"><c:out value="${empty activeContract ? 'Chưa có' : activeContract.maPhong}"/></div><span class="metric-note">Thông tin hợp đồng →</span></a>
  <a class="metric" href="<c:url value='/student/history'/>"><div class="metric-top"><span>Đơn chờ duyệt</span><svg class="nav-icon" aria-hidden="true"><use href="<c:url value='/assets/icons/student.svg'/>#history"/></svg></div><div class="metric-value">${pendingCount}</div><span class="metric-note">Theo dõi kết quả →</span></a>
  <a class="metric" href="<c:url value='/student/invoices'/>"><div class="metric-top"><span>Còn phải đóng</span><svg class="nav-icon" aria-hidden="true"><use href="<c:url value='/assets/icons/student.svg'/>#invoices"/></svg></div><div class="metric-value portal-money"><c:out value="${debtText}"/></div><span class="metric-note">Chi tiết hóa đơn →</span></a>
  <a class="metric" href="<c:url value='/student/repairs'/>"><div class="metric-top"><span>Sửa chữa đang chờ</span><svg class="nav-icon" aria-hidden="true"><use href="<c:url value='/assets/icons/student.svg'/>#repairs"/></svg></div><div class="metric-value">${repairCount}</div><span class="metric-note">Tiến độ xử lý →</span></a>
</div>
<div class="student-dashboard-grid">
  <section class="panel"><div class="panel-head"><h2>Tình hình nội trú</h2></div><div class="panel-body">
    <c:choose><c:when test="${not empty activeContract}"><span class="tag">Đang lưu trú</span><h3 class="student-room-title">Phòng <c:out value="${activeContract.maPhong}"/></h3><p class="muted"><c:out value="${activeContract.tenKhu}"/> · Tầng ${activeContract.tang}</p><dl class="detail-list section-gap"><div><dt>Ngày nhận phòng</dt><dd><c:out value="${activeContract.ngayBatDauText}"/></dd></div><div><dt>Ngày kết thúc</dt><dd><c:out value="${empty activeContract.ngayKetThuc ? 'Chưa xác định' : activeContract.ngayKetThucText}"/></dd></div></dl></c:when>
    <c:when test="${not empty latestRegistration and latestRegistration.trangThai == 'CHO_DUYET'}"><span class="tag amber">Chờ duyệt</span><h3 class="student-room-title">Đơn DK${latestRegistration.maDK}</h3><p class="muted">Phòng <c:out value="${latestRegistration.maPhong}"/> · Gửi ngày <c:out value="${latestRegistration.ngayDangKyText}"/></p><p class="portal-help">Ban quản lý sẽ kiểm tra và duyệt đơn. Bạn có thể hủy khi đơn còn chờ duyệt.</p><a class="btn btn-outline" href="<c:url value='/student/history'/>?id=${latestRegistration.maDK}">Xem đơn đăng ký</a></c:when>
    <c:otherwise><div class="student-empty"><h3>Bắt đầu hành trình nội trú</h3><p>Chọn phòng phù hợp, kiểm tra thông tin và gửi đăng ký. Bạn sẽ nhận hợp đồng sau khi được duyệt.</p><a class="btn btn-primary" href="<c:url value='/student/rooms'/>">Khám phá phòng trống</a></div></c:otherwise></c:choose>
  </div></section>
  <section class="panel"><div class="panel-head"><h2>Thông báo mới</h2><a class="text-link" href="<c:url value='/student/notifications'/>">Tất cả →</a></div><div class="panel-body"><c:forEach items="${notifications}" var="notice"><article class="portal-notice portal-notice-preview"><small><c:out value="${notice.ngayDangText}"/></small><h3><a href="<c:url value='/student/notifications'/>#notice-${notice.maTB}"><c:out value="${notice.tieuDe}"/></a></h3><p class="preserve-text"><c:out value="${notice.noiDung}"/></p></article></c:forEach><c:if test="${empty notifications}"><div class="student-empty"><h3>Bạn đã cập nhật đầy đủ</h3><p>Thông báo mới từ ban quản lý sẽ xuất hiện tại đây.</p></div></c:if></div></section>
</div>
<section class="panel"><div class="panel-head"><div><h2>Hóa đơn cần thanh toán</h2><p>Các khoản chờ xác nhận vẫn được tính trong số tiền còn phải đóng.</p></div><a class="text-link" href="<c:url value='/student/invoices'/>">Tất cả →</a></div><%@ include file="../../common/components/portal-invoices.jspf" %></section>
<%@ include file="../../common/layouts/app-end.jspf" %>
