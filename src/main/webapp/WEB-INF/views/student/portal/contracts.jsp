<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<%@ include file="../../common/components/student-heading.jspf" %>
<c:choose><c:when test="${not empty contract}"><div class="button-group non-print"><a class="btn btn-outline" href="<c:url value='${routePrefix}/contracts'/>">Danh sách hợp đồng</a><button class="btn btn-primary" type="button" data-print>In hợp đồng</button></div><article class="contract-paper"><div class="contract-title"><p>HỆ THỐNG QUẢN LÝ KÝ TÚC XÁ</p><h2>HỢP ĐỒNG LƯU TRÚ</h2><p>Số HĐ${contract.maHDong} · Đơn DK${contract.maDK}</p></div><h3>Thông tin sinh viên</h3><p>Họ tên: <strong><c:out value="${contract.hoTen}"/></strong></p><p>Mã sinh viên: <c:out value="${contract.maSV}"/> · Lớp: <c:out value="${contract.lop}"/></p><p>Khoa: <c:out value="${contract.khoa}"/></p><p>Email: <c:out value="${contract.email}"/> · Điện thoại: <c:out value="${contract.soDienThoai}"/></p><h3>Phòng và thời gian lưu trú</h3><p>Phòng <strong><c:out value="${contract.maPhong}"/></strong> · <c:out value="${contract.tenKhu}"/> · Tầng ${contract.tang}</p><p>Ngày bắt đầu: <c:out value="${contract.ngayBatDauText}"/></p><p>Ngày kết thúc: <c:out value="${empty contract.ngayKetThuc ? 'Chưa xác định' : contract.ngayKetThucText}"/></p><p>Trạng thái: <c:out value="${statusLabels[contract.trangThai]}"/></p><p>Tiền phòng: <c:out value="${contract.giaMoiSVText}"/> / tháng.</p><div class="contract-signatures"><div><strong>BAN QUẢN LÝ</strong><p>Ký và ghi rõ họ tên</p></div><div><strong>SINH VIÊN</strong><p>Ký và ghi rõ họ tên</p><c:out value="${contract.hoTen}"/></div></div></article><c:if test="${adminView and contract.trangThai == 'DANG_O'}"><form class="non-print" method="post" action="<c:url value='/admin/contracts'/>" data-confirm="Kết thúc hợp đồng và giải phóng chỗ ở?"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="finish"><input type="hidden" name="id" value="${contract.maHDong}"><button class="btn btn-danger">Kết thúc hợp đồng</button></form></c:if></c:when><c:otherwise><section class="panel"><div class="table-wrap portal-table"><table><thead><tr><th>Hợp đồng</th><c:if test="${adminView}"><th>Sinh viên</th></c:if><th>Phòng</th><th>Ngày bắt đầu</th><th>Ngày kết thúc</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${contracts}" var="h"><tr><td>HĐ${h.maHDong}</td><c:if test="${adminView}"><td><c:out value="${h.maSV}"/><br><c:out value="${h.hoTen}"/></td></c:if><td><c:out value="${h.maPhong}"/></td><td><c:out value="${h.ngayBatDauText}"/></td><td><c:out value="${empty h.ngayKetThuc ? 'Chưa xác định' : h.ngayKetThucText}"/></td><td><span class="tag ${h.trangThai == 'DANG_O' ? '' : 'gray'}"><c:out value="${statusLabels[h.trangThai]}"/></span></td><td><div class="button-group"><a class="btn btn-outline btn-sm" href="<c:url value='${routePrefix}/contracts'/>?id=${h.maHDong}">Chi tiết</a><a class="btn btn-soft btn-sm" href="<c:url value='${routePrefix}/contracts'/>?id=${h.maHDong}&amp;print=1">Bản in</a></div></td></tr></c:forEach><c:if test="${empty contracts}"><tr><td colspan="7" class="empty-cell">Chưa có hợp đồng.</td></tr></c:if></tbody></table></div></section></c:otherwise></c:choose>
<%@ include file="../../common/layouts/app-end.jspf" %>
