<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<div class="page-heading"><div><h1><c:out value="${pageTitle}"/></h1></div></div>
<section class="panel"><div class="panel-head"><h2>Ghi nhận tiền mặt</h2></div><div class="panel-body"><c:choose><c:when test="${empty payableInvoices}"><p class="muted">Không có hóa đơn còn có thể ghi nhận thêm tiền.</p></c:when><c:otherwise><form method="post" action="<c:url value='/admin/payments'/>" data-confirm="Xác nhận đã nhận khoản tiền mặt này?"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="cash"><div class="form-grid"><div class="field"><label for="cashInvoice">Hóa đơn</label><select id="cashInvoice" name="id" class="form-select" required><c:forEach items="${payableInvoices}" var="i"><option value="${i.maHoaDon}">HD${i.maHoaDon} · <c:out value="${i.hoTen}"/> · ${i.thang}/${i.nam} · Có thể thu <c:out value="${i.coTheGuiText}"/></option></c:forEach></select></div><div class="field"><label for="cashAmount">Số tiền (VNĐ)</label><input id="cashAmount" name="amount" type="number" class="form-control" min="1" max="999999999999" step="1" required></div></div><button class="btn btn-primary">Ghi nhận tiền mặt</button></form></c:otherwise></c:choose></div></section><section class="panel"><div class="panel-head"><h2>Duyệt và lịch sử thanh toán</h2></div><%@ include file="../../common/components/portal-payments.jspf" %></section>
<%@ include file="../../common/layouts/app-end.jspf" %>
