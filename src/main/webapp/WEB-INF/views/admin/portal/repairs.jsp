<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<div class="page-heading"><div><h1><c:out value="${pageTitle}"/></h1></div></div>
<section class="panel"><div class="table-wrap portal-table"><table><thead><tr><th>Yêu cầu</th><th>Sinh viên</th><th>Phòng</th><th>Nội dung</th><th>Ngày gửi</th><th>Tiến độ</th></tr></thead><tbody><c:forEach items="${repairs}" var="r"><tr><td>YC${r.maYC}</td><td><c:out value="${r.maSV}"/><br><c:out value="${r.hoTen}"/></td><td><c:out value="${r.maPhong}"/></td><td class="preserve-text"><c:out value="${r.noiDung}"/></td><td><c:out value="${r.ngayGuiText}"/></td><td><c:choose><c:when test="${r.trangThai == 'HOAN_THANH'}"><span class="tag">Hoàn thành</span></c:when><c:otherwise><form method="post" action="<c:url value='/admin/repairs'/>"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="${r.maYC}"><select name="status" class="form-select" aria-label="Tiến độ yêu cầu YC${r.maYC}"><c:forTokens items="MOI,DANG_XU_LY,HOAN_THANH" delims="," var="s"><option value="${s}" ${r.trangThai == s ? 'selected' : ''}><c:out value="${statusLabels[s]}"/></option></c:forTokens></select><button class="btn btn-outline btn-sm section-gap">Lưu</button></form></c:otherwise></c:choose></td></tr></c:forEach><c:if test="${empty repairs}"><tr><td colspan="6" class="empty-cell">Chưa có yêu cầu sửa chữa.</td></tr></c:if></tbody></table></div></section>
<%@ include file="../../common/layouts/app-end.jspf" %>
