<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<div class="page-heading"><div><h1><c:out value="${pageTitle}"/></h1></div></div>
<section class="panel"><div class="panel-head"><h2>Tạo hóa đơn theo tháng</h2></div><div class="panel-body"><c:choose><c:when test="${empty contracts}"><p class="muted">Chưa có hợp đồng để tạo hóa đơn.</p></c:when><c:otherwise><form method="post" action="<c:url value='/admin/invoices'/>"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="create"><div class="form-grid"><div class="field full"><label for="contractId">Hợp đồng</label><select id="contractId" name="id" class="form-select" required><option value="">Chọn hợp đồng</option><c:forEach items="${contracts}" var="h"><option value="${h.maHDong}" ${param.id == h.maHDong.toString() ? 'selected' : ''}>HĐ${h.maHDong} · <c:out value="${h.hoTen}"/> · <c:out value="${h.maSV}"/> · <c:out value="${h.maPhong}"/></option></c:forEach></select></div><div class="field"><label for="month">Tháng</label><input id="month" name="month" type="number" min="1" max="12" class="form-control" value="<c:out value='${empty param.month ? today.monthValue : param.month}'/>" required></div><div class="field"><label for="year">Năm</label><input id="year" name="year" type="number" min="2020" max="2100" class="form-control" value="<c:out value='${empty param.year ? today.year : param.year}'/>" required></div><div class="field"><label for="electricity">Tiền điện (VNĐ)</label><input id="electricity" name="electricity" type="number" class="form-control" min="0" max="999999999999" step="1" value="<c:out value='${empty param.electricity ? 0 : param.electricity}'/>" required></div><div class="field"><label for="water">Tiền nước (VNĐ)</label><input id="water" name="water" type="number" class="form-control" min="0" max="999999999999" step="1" value="<c:out value='${empty param.water ? 0 : param.water}'/>" required></div><div class="field"><label for="due">Hạn thanh toán</label><input id="due" name="due" type="date" class="form-control" value="<c:out value='${param.due}'/>" required></div></div><button class="btn btn-primary">Tạo hóa đơn</button></form></c:otherwise></c:choose></div></section><%@ include file="../../common/components/portal-invoice-detail.jspf" %><section class="panel"><div class="panel-head"><h2>Các hóa đơn đã tạo</h2></div><%@ include file="../../common/components/portal-invoices.jspf" %></section>
<%@ include file="../../common/layouts/app-end.jspf" %>
