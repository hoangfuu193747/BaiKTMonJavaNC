<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<div class="page-heading"><div><h1><c:out value="${pageTitle}"/></h1></div></div>
<section class="panel"><div class="panel-head"><h2>Đăng thông báo cho sinh viên</h2></div><div class="panel-body"><form method="post" action="<c:url value='/admin/notifications'/>"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="publish"><div class="field"><label for="title">Tiêu đề</label><input id="title" name="title" class="form-control" maxlength="200" value="<c:out value='${param.title}'/>" required></div><div class="field"><label for="body">Nội dung</label><textarea id="body" name="body" class="form-control" rows="6" maxlength="20000" required><c:out value="${param.body}"/></textarea></div><button class="btn btn-primary">Đăng thông báo</button></form></div></section><section class="panel"><div class="panel-head"><h2>Thông báo đã đăng</h2></div><div class="panel-body"><c:forEach items="${notifications}" var="n"><article class="portal-notice"><h2><c:out value="${n.tieuDe}"/></h2><small><c:out value="${n.ngayDangText}"/></small><p class="preserve-text"><c:out value="${n.noiDung}"/></p></article></c:forEach><c:if test="${empty notifications}"><p class="muted">Chưa có thông báo.</p></c:if></div></section>
<%@ include file="../../common/layouts/app-end.jspf" %>
