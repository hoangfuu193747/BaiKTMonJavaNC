<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<div class="page-heading"><div><h1><c:out value="${pageTitle}"/></h1></div></div>
<section class="panel"><form class="filter-bar" method="get" action="<c:url value='/admin/registrations'/>"><select class="form-select" name="status" aria-label="Trạng thái đơn"><option value="">Tất cả đơn</option><c:forTokens items="CHO_DUYET,DA_DUYET,TU_CHOI,DA_HUY" delims="," var="s"><option value="${s}" ${status == s ? 'selected' : ''}><c:out value="${statusLabels[s]}"/></option></c:forTokens></select><button class="btn btn-outline">Lọc</button></form><div class="panel-body"><c:forEach items="${registrations}" var="r"><article class="portal-notice"><div class="portal-card-head"><h2>DK${r.maDK} · <c:out value="${r.hoTen}"/></h2><span class="tag ${r.trangThai == 'CHO_DUYET' ? 'amber' : ''}"><c:out value="${statusLabels[r.trangThai]}"/></span></div><p><c:out value="${r.maSV}"/> · Phòng <c:out value="${r.maPhong}"/> · <c:out value="${r.ngayDangKyText}"/></p><c:choose><c:when test="${r.trangThai == 'CHO_DUYET'}"><p><span class="tag ${empty r.reasons ? '' : 'red'}">${empty r.reasons ? 'Đủ điều kiện' : 'Không đủ điều kiện'}</span></p><c:forEach items="${r.reasons}" var="reason"><p class="portal-reasons"><c:out value="${reason}"/></p></c:forEach><details class="portal-review" ${not empty flashError and param.id == r.maDK.toString() ? 'open' : ''}><summary>Xử lý đơn</summary><div class="dashboard-status"><form method="post" action="<c:url value='/admin/registrations'/>" data-confirm="Duyệt đơn và tạo hợp đồng lưu trú?"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="approve"><input type="hidden" name="id" value="${r.maDK}"><div class="form-grid"><div class="field"><label for="start${r.maDK}">Ngày bắt đầu</label><input id="start${r.maDK}" name="start" type="date" class="form-control" value="${today}" required></div><div class="field"><label for="end${r.maDK}">Ngày kết thúc dự kiến</label><input id="end${r.maDK}" name="end" type="date" class="form-control" value="${defaultEnd}"></div></div><button class="btn btn-primary" ${not empty r.reasons ? 'disabled' : ''}>Duyệt đơn</button></form><form method="post" action="<c:url value='/admin/registrations'/>" data-confirm="Từ chối đơn này?"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="reject"><input type="hidden" name="id" value="${r.maDK}"><div class="field"><label for="reason${r.maDK}">Lý do từ chối</label><input id="reason${r.maDK}" name="reason" class="form-control" maxlength="255" required></div><button class="btn btn-danger">Từ chối</button></form></div></details></c:when><c:otherwise><c:if test="${not empty r.lyDoTuChoi}"><p><c:out value="${r.lyDoTuChoi}"/></p></c:if></c:otherwise></c:choose></article></c:forEach><c:if test="${empty registrations}"><p class="empty-cell">Chưa có đơn phù hợp.</p></c:if></div></section>
<%@ include file="../../common/layouts/app-end.jspf" %>
