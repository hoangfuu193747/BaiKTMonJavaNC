<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<%@ include file="../../common/components/admin-heading.jspf" %>
<c:choose><c:when test="${showForm}">
<section class="panel"><div class="panel-head"><h2>${editing ? 'Cập nhật hồ sơ' : 'Thêm sinh viên vào danh sách trường'}</h2><a class="text-link" href="<c:url value='/admin/students'/>">Quay lại danh sách</a></div><div class="panel-body"><form class="admin-record-form" method="post" action="<c:url value='/admin/students'/>"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="${editing ? 'update' : 'create'}"><div class="form-grid">
<div class="field"><label for="student-id">Mã sinh viên</label><input id="student-id" name="id" class="form-control" maxlength="10" pattern="[A-Za-z0-9_.\-]+" value="<c:out value='${param.id != null ? param.id : student.maSV}'/>" ${editing ? 'readonly' : ''} required></div>
<div class="field"><label for="student-name">Họ và tên</label><input id="student-name" name="name" class="form-control" maxlength="100" value="<c:out value='${param.name != null ? param.name : student.hoTen}'/>" required></div>
<div class="field"><label for="student-birthday">Ngày sinh</label><input id="student-birthday" name="birthday" class="form-control" type="date" value="<c:out value='${param.birthday != null ? param.birthday : student.ngaySinh}'/>" required></div>
<div class="field"><label for="student-gender">Giới tính</label><select id="student-gender" name="gender" class="form-select" required><option value="">Chọn giới tính</option><option value="Nam" ${(param.gender != null ? param.gender : student.gioiTinh) == 'Nam' ? 'selected' : ''}>Nam</option><option value="Nữ" ${(param.gender != null ? param.gender : student.gioiTinh) == 'Nữ' ? 'selected' : ''}>Nữ</option></select></div>
<div class="field"><label for="student-class">Lớp</label><input id="student-class" name="className" class="form-control" maxlength="20" value="<c:out value='${param.className != null ? param.className : student.lop}'/>" required></div>
<div class="field"><label for="student-faculty">Khoa</label><input id="student-faculty" name="faculty" class="form-control" maxlength="100" value="<c:out value='${param.faculty != null ? param.faculty : student.khoa}'/>" required></div>
<div class="field full"><label for="student-email">Email đối chiếu khi đăng ký tài khoản</label><input id="student-email" name="email" class="form-control" type="email" maxlength="120" value="<c:out value='${param.email != null ? param.email : student.email}'/>" required></div>
<c:if test="${editing and not empty student.maTK}"><div class="field"><label for="student-phone">Số điện thoại (tùy chọn)</label><input id="student-phone" name="phone" class="form-control" type="tel" maxlength="15" pattern="\+?[0-9]{9,14}" value="<c:out value='${param.phone != null ? param.phone : student.soDienThoai}'/>"></div></c:if>
</div><p class="info-box section-gap">Hồ sơ trường cho phép sinh viên tự đăng ký tài khoản bằng mã sinh viên và email tương ứng. Khi cập nhật giới tính, hệ thống kiểm tra phòng đang ở và đơn chờ duyệt.</p><div class="button-group"><button class="btn btn-primary">Lưu hồ sơ</button><a class="btn btn-outline" href="<c:url value='/admin/students'/>">Hủy</a></div></form></div></section>
</c:when><c:otherwise>
<section class="panel"><form class="filter-bar" method="get" action="<c:url value='/admin/students'/>"><input class="control" name="q" maxlength="100" aria-label="Tìm sinh viên" placeholder="Tìm mã sinh viên, họ tên, lớp hoặc email" value="<c:out value='${q}'/>"><button class="btn btn-outline">Tìm kiếm</button><a class="btn btn-primary" href="<c:url value='/admin/students'/>?action=new">+ Thêm sinh viên</a><c:if test="${not empty q}"><a class="text-link" href="<c:url value='/admin/students'/>">Xóa bộ lọc</a></c:if></form>
<div class="table-wrap portal-table"><table><thead><tr><th>Sinh viên</th><th>Lớp / Khoa</th><th>Email</th><th>Phòng</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${students}" var="studentRow"><tr><td><strong><c:out value="${studentRow.hoTen}"/></strong><small class="portal-cell-note"><c:out value="${studentRow.maSV}"/> · <c:out value="${studentRow.gioiTinh}"/></small></td><td><c:out value="${studentRow.lop}"/><small class="portal-cell-note"><c:out value="${studentRow.khoa}"/></small></td><td><c:out value="${studentRow.email}"/></td><td><c:out value="${empty studentRow.maPhong ? 'Chưa có' : studentRow.maPhong}"/></td><td><span class="tag ${studentRow.hoSoHoatDong ? '' : 'red'}">${studentRow.hoSoHoatDong ? 'Hồ sơ hợp lệ' : 'Hồ sơ vô hiệu'}</span><small class="portal-cell-note">${empty studentRow.maTK ? 'Chưa tạo tài khoản' : (studentRow.taiKhoanHoatDong ? 'Tài khoản đang mở' : 'Tài khoản đã khóa')}</small></td><td><details class="admin-actions"><summary>Quản lý</summary><a class="btn btn-outline btn-sm" href="<c:url value='/admin/students'/>?action=edit&amp;id=<c:out value='${studentRow.maSV}'/>">Sửa hồ sơ</a>
<form method="post" action="<c:url value='/admin/students'/>" data-confirm="Thay đổi trạng thái hồ sơ trường? Hồ sơ vô hiệu sẽ không được đăng ký hoặc đăng nhập."><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="rosterState"><input type="hidden" name="id" value="<c:out value='${studentRow.maSV}'/>"><input type="hidden" name="active" value="${studentRow.hoSoHoatDong ? 0 : 1}"><button class="btn btn-outline btn-sm">${studentRow.hoSoHoatDong ? 'Vô hiệu hồ sơ' : 'Kích hoạt hồ sơ'}</button></form>
<c:choose><c:when test="${not empty studentRow.maTK}"><form method="post" action="<c:url value='/admin/students'/>" data-confirm="Thay đổi trạng thái tài khoản sinh viên?"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="accountState"><input type="hidden" name="id" value="<c:out value='${studentRow.maSV}'/>"><input type="hidden" name="active" value="${studentRow.taiKhoanHoatDong ? 0 : 1}"><button class="btn btn-outline btn-sm">${studentRow.taiKhoanHoatDong ? 'Khóa tài khoản' : 'Mở tài khoản'}</button></form></c:when><c:otherwise><form method="post" action="<c:url value='/admin/students'/>" data-confirm="Xóa hồ sơ sinh viên chưa đăng ký này? Thao tác không thể hoàn tác."><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<c:out value='${studentRow.maSV}'/>"><button class="btn btn-danger btn-sm">Xóa hồ sơ</button></form></c:otherwise></c:choose>
</details></td></tr></c:forEach><c:if test="${empty students}"><tr><td colspan="6" class="empty-cell">Không tìm thấy hồ sơ phù hợp.</td></tr></c:if></tbody></table></div></section><%@ include file="../../common/components/admin-pagination.jspf" %>
</c:otherwise></c:choose>
<%@ include file="../../common/layouts/app-end.jspf" %>
