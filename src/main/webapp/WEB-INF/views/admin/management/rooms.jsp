<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<%@ include file="../../common/components/admin-heading.jspf" %>
<c:if test="${not empty selectedRoom}"><section class="panel"><div class="panel-head"><h2>Phòng <c:out value="${selectedRoom.maPhong}"/></h2></div><div class="panel-body"><form class="portal-form" method="post" action="<c:url value='/admin/rooms'/>"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="<c:out value='${selectedRoom.maPhong}'/>"><p class="portal-help"><c:out value="${selectedRoom.tenKhu}"/> · Tầng ${selectedRoom.tang} · <c:out value="${selectedRoom.gioiTinh}"/> · ${selectedRoom.dangO}/${selectedRoom.sucChua} người đang ở</p><div class="field"><label for="room-status">Trạng thái phòng</label><select id="room-status" name="roomStatus" class="form-select"><option value="HOAT_DONG" ${(param.roomStatus != null ? param.roomStatus : selectedRoom.trangThai) == 'HOAT_DONG' ? 'selected' : ''}>Hoạt động</option><option value="BAO_TRI" ${(param.roomStatus != null ? param.roomStatus : selectedRoom.trangThai) == 'BAO_TRI' ? 'selected' : ''}>Bảo trì · Không nhận đăng ký mới</option></select></div><p class="info-box">Theo cấu hình hiện tại: 4 sinh viên/phòng, 700.000 ₫/sinh viên/tháng. Bảo trì chặn đăng ký mới, không tự kết thúc hợp đồng của người đang ở.</p><div class="button-group"><button class="btn btn-primary">Lưu trạng thái</button><a class="btn btn-outline" href="<c:url value='/admin/rooms'/>">Hủy</a></div></form></div></section></c:if>
<section class="panel"><form class="filter-bar admin-room-filters" method="get" action="<c:url value='/admin/rooms'/>"><input class="control" name="q" maxlength="100" aria-label="Tìm phòng" placeholder="Mã phòng hoặc tên khu" value="<c:out value='${q}'/>"><select class="form-select" name="zone" aria-label="Khu nhà"><option value="">Tất cả khu</option><c:forTokens items="A,B,C,D" delims="," var="zoneCode"><option value="${zoneCode}" ${zone == zoneCode ? 'selected' : ''}>Khu ${zoneCode}</option></c:forTokens></select><select class="form-select" name="floor" aria-label="Tầng"><option value="">Tất cả tầng</option><c:forEach begin="1" end="5" var="floorNumber"><option value="${floorNumber}" ${floor == floorNumber.toString() ? 'selected' : ''}>Tầng ${floorNumber}</option></c:forEach></select><select class="form-select" name="status" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option><option value="HOAT_DONG" ${status == 'HOAT_DONG' ? 'selected' : ''}>Hoạt động</option><option value="BAO_TRI" ${status == 'BAO_TRI' ? 'selected' : ''}>Bảo trì</option></select><button class="btn btn-primary">Lọc phòng</button><a class="btn btn-outline" href="<c:url value='/admin/rooms'/>">Đặt lại</a></form><div class="table-wrap portal-table"><table><thead><tr><th>Phòng</th><th>Khu / Tầng</th><th>Dành cho</th><th>Đang ở</th><th>Giá / SV / tháng</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${rooms}" var="roomRow"><tr><td><strong><c:out value="${roomRow.maPhong}"/></strong></td><td><c:out value="${roomRow.tenKhu}"/> / ${roomRow.tang}</td><td><c:out value="${roomRow.gioiTinh}"/></td><td>${roomRow.dangO}/${roomRow.sucChua}</td><td class="portal-currency"><c:out value="${roomRow.giaMoiSVText}"/></td><td><span class="tag ${roomRow.trangThai == 'HOAT_DONG' and roomRow.khuHoatDong ? '' : 'amber'}">${not roomRow.khuHoatDong ? 'Khu tạm dừng' : (roomRow.trangThai == 'HOAT_DONG' ? 'Hoạt động' : 'Bảo trì')}</span></td><td><a class="btn btn-outline btn-sm" href="<c:url value='/admin/rooms'/>?id=<c:out value='${roomRow.maPhong}'/>">Chỉnh sửa</a></td></tr></c:forEach><c:if test="${empty rooms}"><tr><td colspan="7" class="empty-cell">Không có phòng phù hợp với bộ lọc.</td></tr></c:if></tbody></table></div></section><%@ include file="../../common/components/admin-pagination.jspf" %>
<%@ include file="../../common/layouts/app-end.jspf" %>
