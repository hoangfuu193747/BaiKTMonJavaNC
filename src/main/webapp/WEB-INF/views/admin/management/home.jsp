<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<%@ include file="../../common/components/admin-heading.jspf" %>
<div class="metrics metrics-four"><a class="metric" href="<c:url value='/admin/students'/>"><div class="metric-top"><span>Sinh viên trường</span></div><div class="metric-value">${stats.sinhVien}</div><small>${stats.taiKhoan} tài khoản đang mở</small></a><a class="metric" href="<c:url value='/admin/rooms'/>"><div class="metric-top"><span>Sinh viên đang ở</span></div><div class="metric-value">${stats.dangO}</div><small>${stats.soPhong} phòng trong hệ thống</small></a><a class="metric" href="<c:url value='/admin/registrations'/>"><div class="metric-top"><span>Đơn cần duyệt</span></div><div class="metric-value">${stats.choDuyet}</div><small>Xem và xử lý đăng ký →</small></a><a class="metric" href="<c:url value='/admin/invoices'/>"><div class="metric-top"><span>Còn phải thu</span></div><div class="metric-value admin-money"><c:out value="${debtText}"/></div><small>Chỉ trừ khoản đã xác nhận</small></a></div>
<div class="dashboard-links"><a class="activity-card" href="<c:url value='/admin/students'/>?action=new"><h3>Thêm hồ sơ sinh viên →</h3></a><a class="activity-card" href="<c:url value='/admin/repairs'/>"><h3>${stats.suaChua} yêu cầu sửa chữa chưa xong →</h3></a><a class="activity-card" href="<c:url value='/admin/reports'/>"><h3>Xem và xuất báo cáo →</h3></a></div>
<section class="panel"><div class="panel-head"><h2>Đơn đăng ký chờ duyệt gần đây</h2><a class="text-link" href="<c:url value='/admin/registrations'/>">Xử lý tất cả →</a></div><div class="table-wrap portal-table"><table><thead><tr><th>Mã đơn</th><th>Sinh viên</th><th>Phòng</th><th>Ngày gửi</th></tr></thead><tbody><c:forEach items="${registrations}" var="application"><tr><td>DK${application.maDK}</td><td><c:out value="${application.hoTen}"/><small class="portal-cell-note"><c:out value="${application.maSV}"/></small></td><td><c:out value="${application.maPhong}"/></td><td><c:out value="${application.ngayDangKyText}"/></td></tr></c:forEach><c:if test="${empty registrations}"><tr><td colspan="4" class="empty-cell">Không có đơn đang chờ duyệt.</td></tr></c:if></tbody></table></div></section>
<section class="panel"><div class="panel-head"><h2>Tình hình theo khu</h2><a class="text-link" href="<c:url value='/admin/zones'/>">Quản lý khu nhà →</a></div><div class="table-wrap portal-table"><table><thead><tr><th>Khu</th><th>Dành cho</th><th>Số phòng</th><th>Tổng chỗ</th><th>Đang ở</th><th>Chỗ trống</th></tr></thead><tbody><c:forEach items="${reports}" var="report"><tr><td><c:out value="${report.tenKhu}"/></td><td><c:out value="${report.gioiTinh}"/></td><td>${report.soPhong}</td><td>${report.tongCho}</td><td>${report.dangO}</td><td>${report.tongCho - report.dangO}</td></tr></c:forEach></tbody></table></div></section>
<%@ include file="../../common/layouts/app-end.jspf" %>
