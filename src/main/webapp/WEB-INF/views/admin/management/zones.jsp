<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<%@ include file="../../common/components/admin-heading.jspf" %>
<c:if test="${not empty selectedZone}"><section class="panel"><div class="panel-head"><h2>Cập nhật khu <c:out value="${selectedZone.maKhu}"/></h2></div><div class="panel-body"><form class="portal-form" method="post" action="<c:url value='/admin/zones'/>"><%@ include file="../../common/components/portal-token.jspf" %><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="<c:out value='${selectedZone.maKhu}'/>"><div class="field"><label for="zone-name">Tên khu</label><input id="zone-name" name="name" class="form-control" maxlength="30" value="<c:out value='${param.name != null ? param.name : selectedZone.tenKhu}'/>" required></div><div class="field"><label for="zone-active">Trạng thái tiếp nhận</label><select id="zone-active" name="active" class="form-select"><option value="1" ${(param.active != null ? param.active == '1' : selectedZone.hoatDong) ? 'selected' : ''}>Hoạt động</option><option value="0" ${(param.active != null ? param.active == '0' : not selectedZone.hoatDong) ? 'selected' : ''}>Tạm dừng đăng ký mới</option></select></div><p class="info-box">Tạm dừng khu sẽ chặn đăng ký mới và duyệt đơn vào khu này. Hợp đồng và dữ liệu đang có vẫn được giữ. Giới tính và số tầng theo cấu hình cố định của ký túc xá.</p><div class="button-group"><button class="btn btn-primary">Lưu thay đổi</button><a class="btn btn-outline" href="<c:url value='/admin/zones'/>">Hủy</a></div></form></div></section></c:if>
<div class="admin-zone-grid"><c:forEach items="${zones}" var="zoneRow"><section class="panel"><div class="panel-head"><h2><c:out value="${zoneRow.tenKhu}"/></h2><span class="tag ${zoneRow.hoatDong ? '' : 'amber'}">${zoneRow.hoatDong ? 'Hoạt động' : 'Tạm dừng'}</span></div><div class="panel-body"><dl class="detail-list"><div><dt>Mã khu</dt><dd><c:out value="${zoneRow.maKhu}"/></dd></div><div><dt>Dành cho</dt><dd><c:out value="${zoneRow.gioiTinh}"/></dd></div><div><dt>Số tầng / phòng</dt><dd>${zoneRow.soTang} / ${zoneRow.soPhong}</dd></div><div><dt>Tổng chỗ</dt><dd>${zoneRow.tongCho}</dd></div></dl><a class="btn btn-outline section-gap" href="<c:url value='/admin/zones'/>?id=<c:out value='${zoneRow.maKhu}'/>">Chỉnh sửa khu</a></div></section></c:forEach></div>
<%@ include file="../../common/layouts/app-end.jspf" %>
