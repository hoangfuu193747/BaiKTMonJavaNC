<%@ page pageEncoding="UTF-8" %>
<%@ include file="../../common/layouts/app-start.jspf" %>
<%@ include file="../../common/components/admin-heading.jspf" %>
<section class="panel"><form class="filter-bar admin-report-filters non-print" method="get" action="<c:url value='/admin/reports'/>"><div class="field"><label for="report-zone">Khu nhà</label><select id="report-zone" name="zone" class="form-select"><option value="">Tất cả khu</option><c:forTokens items="A,B,C,D" delims="," var="zoneCode"><option value="${zoneCode}" ${zone == zoneCode ? 'selected' : ''}>Khu ${zoneCode}</option></c:forTokens></select></div><div class="field"><label for="report-month">Tháng hóa đơn</label><select id="report-month" name="month" class="form-select"><option value="">Tất cả kỳ</option><c:forEach begin="1" end="12" var="monthNumber"><option value="${monthNumber}" ${month == monthNumber.toString() ? 'selected' : ''}>Tháng ${monthNumber}</option></c:forEach></select></div><div class="field"><label for="report-year">Năm hóa đơn</label><input id="report-year" name="year" type="number" min="2020" max="2100" class="form-control" placeholder="Ví dụ: 2026" value="<c:out value='${year}'/>"></div><div class="button-group"><button class="btn btn-primary">Xem báo cáo</button><button class="btn btn-outline" name="export" value="csv">Xuất CSV</button><a class="btn btn-outline" href="<c:url value='/admin/reports'/>">Đặt lại</a><button class="btn btn-outline" type="button" data-print>In</button></div></form><div class="panel-body"><p class="muted">Số người ở, phòng và đơn chờ được tính tại thời điểm hiện tại. Doanh thu và công nợ tính theo kỳ hóa đơn đã chọn; để trống cả tháng và năm để xem toàn bộ.</p></div></section>
<section class="panel"><div class="panel-head"><h2>Báo cáo theo khu · <c:out value="${empty month ? 'Tất cả kỳ' : month}"/> / <c:out value="${empty year ? 'Tất cả năm' : year}"/></h2></div><div class="table-wrap portal-table admin-report-table"><table><thead><tr><th>Khu</th><th>Số phòng</th><th>Tổng chỗ</th><th>Đang ở</th><th>Đơn chờ</th><th>Tổng hóa đơn</th><th>Đã xác nhận</th><th>Chờ xác nhận</th><th>Còn phải đóng</th></tr></thead><tbody><c:set var="totalBilled" value="0"/><c:set var="totalPaid" value="0"/><c:set var="totalPending" value="0"/><c:set var="totalDebt" value="0"/><c:forEach items="${reports}" var="report"><c:set var="totalBilled" value="${totalBilled + report.tongTien}"/><c:set var="totalPaid" value="${totalPaid + report.daDong}"/><c:set var="totalPending" value="${totalPending + report.choXacNhan}"/><c:set var="totalDebt" value="${totalDebt + report.conNo}"/><tr><td><c:out value="${report.tenKhu}"/><small class="portal-cell-note"><c:out value="${report.gioiTinh}"/></small></td><td>${report.soPhong}</td><td>${report.tongCho}</td><td>${report.dangO}</td><td>${report.choDuyet}</td><td class="portal-currency"><c:out value="${report.tongTienText}"/></td><td class="portal-currency"><c:out value="${report.daDongText}"/></td><td class="portal-currency"><c:out value="${report.choXacNhanText}"/></td><td class="portal-currency"><strong><c:out value="${report.conNoText}"/></strong></td></tr></c:forEach><c:if test="${empty reports}"><tr><td colspan="9" class="empty-cell">Chưa có dữ liệu phù hợp.</td></tr></c:if></tbody><c:if test="${not empty reports}"><tfoot><tr><th colspan="5">Tổng cộng</th><td class="portal-currency"><fmt:formatNumber value="${totalBilled}"/> ₫</td><td class="portal-currency"><fmt:formatNumber value="${totalPaid}"/> ₫</td><td class="portal-currency"><fmt:formatNumber value="${totalPending}"/> ₫</td><td class="portal-currency"><fmt:formatNumber value="${totalDebt}"/> ₫</td></tr></tfoot></c:if></table></div></section>
<%@ include file="../../common/layouts/app-end.jspf" %>
